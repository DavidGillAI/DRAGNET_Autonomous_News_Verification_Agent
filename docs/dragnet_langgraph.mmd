flowchart TD
    START([Start]) --> plan_initial_search
    plan_initial_search --> research
    research --> web_verification

    web_verification -->|assess_query| assess_query
    web_verification -->|assess_source_diversity| assess_source_diversity

    assess_query -->|continue_research| assess_source_diversity
    assess_query -->|request_clarification| request_clarification
    request_clarification --> END([End])

    assess_source_diversity -->|prepare_evidence| prepare_evidence
    assess_source_diversity -->|prepare_limited_evidence| prepare_evidence
    assess_source_diversity -->|research_more| plan_follow_up_research

    prepare_evidence -->|generate| generate_draft
    prepare_evidence -->|revise| revise_draft

    generate_draft --> validate_draft
    revise_draft --> validate_draft

    validate_draft -->|research_more| plan_follow_up_research
    validate_draft -->|finish| finalise_report

    plan_follow_up_research --> research
    finalise_report --> END

    classDef process fill:#0B1F33,stroke:#25C2F5,color:#FFFFFF,stroke-width:2px;
    classDef decision fill:#392B6B,stroke:#B9A7FF,color:#FFFFFF,stroke-width:2px;
    classDef output fill:#0E5135,stroke:#54D89A,color:#FFFFFF,stroke-width:2px;
    classDef endpoint fill:#1D4ED8,stroke:#7DD3FC,color:#FFFFFF,stroke-width:2px;

    class plan_initial_search,research,web_verification,prepare_evidence,generate_draft,revise_draft,plan_follow_up_research process;
    class assess_query,assess_source_diversity,validate_draft decision;
    class request_clarification,finalise_report output;
    class START,END endpoint;


